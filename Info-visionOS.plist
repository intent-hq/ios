<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- visionOS variant of Intent/Info.plist (selected via the
	     SDK-conditioned INFOPLIST_FILE build setting): identical except for
	     the dictation usage strings at the end, which must not appear on
	     iOS. Keep the shared keys in sync with Intent/Info.plist — enforced
	     by IntentTests/InfoPlistSyncTests.swift. -->
	<!-- intent:// deep links (pairing via intent://pair, protocol §5). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>dev.intentapp.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>intent</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Thin.ttf</string>
		<string>Inter-ThinItalic.ttf</string>
		<string>Inter-ExtraLight.ttf</string>
		<string>Inter-ExtraLightItalic.ttf</string>
		<string>Inter-Light.ttf</string>
		<string>Inter-LightItalic.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Italic.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-MediumItalic.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-SemiBoldItalic.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-BoldItalic.ttf</string>
		<string>Inter-ExtraBold.ttf</string>
		<string>Inter-ExtraBoldItalic.ttf</string>
		<string>Inter-Black.ttf</string>
		<string>Inter-BlackItalic.ttf</string>
	</array>
	<!-- Multi-scene support for the pinned-backend windows
	     (WindowGroup(for: BackendID.self)) on visionOS and iPad. iPhone
	     never offers multiple scenes, so its behaviour is unchanged. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Intent connects to your computers and opens web servers on your local network.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>ThemeBackground</string>
	</dict>
	<!-- Add-only photo library access for the chat image "Save Image" action. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Intent saves images from your conversations to your photo library when you choose Save Image.</string>
	<!-- Team-ID prefix ("TEAMID.") for building keychain access-group names
	     at runtime (SyncedBackendRegistry); iOS has no public entitlement
	     introspection API. -->
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- Composer dictation (SpeechDictationController, visionOS only). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Intent uses the microphone to dictate messages into the composer.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Intent uses speech recognition to transcribe your dictated messages.</string>
</dict>
</plist>
