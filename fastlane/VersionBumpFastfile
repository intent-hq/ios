require_relative "lib/version_bump"

platform :ios do
  desc "Open or update the patch-version PR after either platform is submitted; dry_run only reads Apple"
  lane :check_version_bump do |options|
    dry_run = options.fetch(:dry_run, false)
    UI.user_error!("dry_run must be true or false") unless [true, false, "true", "false"].include?(dry_run)
    app = app_store_connect_app
    plan = VersionBump.plan(app, ReleaseSupport.marketing_version)
    if plan.nil?
      UI.success("no bump needed")
    elsif dry_run == true || dry_run == "true"
      UI.success("would bump #{plan.fetch(:from)} → #{plan.fetch(:to)}")
    else
      VersionBump.publish(plan)
      UI.success("Version-bump PR ready: #{plan.fetch(:from)} → #{plan.fetch(:to)}")
    end
    plan
  end
end
