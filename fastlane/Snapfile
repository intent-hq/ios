# Snapfile — configuration for `fastlane snapshot`
# https://docs.fastlane.tools/actions/snapshot/
#
# How to run (Mac only, from the repo root):
#
#   bundle exec fastlane screenshots     # via the Fastfile lane
#   # or, without bundler (fastlane from Homebrew/gem):
#   fastlane screenshots
#
# Always go through the `screenshots` lane — it first erases the simulators
# and seeds SpringBoard prefs (Fastfile → prepare_screenshot_simulators).
# Running `fastlane snapshot` directly skips that preparation: stale
# UserDefaults/pairing state and the iPadOS window-resize grabber arc
# would leak into the captures.
#
# Output lands in fastlane/screenshots/ (gitignored) with an HTML preview
# (screenshots.html). The devices below need their simulators available in
# the selected Xcode; `xcrun simctl list devicetypes` shows what's installed.
# If a device is missing, create it with
# `xcrun simctl create "<name>" "<devicetype>"` or install the matching
# runtime via Xcode → Settings → Components.

# The two required App Store screenshot sizes:
#   iPhone 6.9" — iPhone 17 Pro Max
#   iPad 13"    — iPad Pro 13-inch (M4)
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M4)"
])

languages(["en-US"])

# Dedicated scheme whose test action runs only IntentUITests
# (Intent.xcodeproj/xcshareddata/xcschemes/IntentScreenshots.xcscheme).
project("./Intent.xcodeproj")
scheme("IntentScreenshots")

# Only the screenshot suite — skips the Xcode template tests in the target
# (IntentUITests.swift, IntentUITestsLaunchTests.swift), which would add
# several extra app launches per device and abort surface.
only_testing(["IntentUITests/AppStoreScreenshotTests"])

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Marketing screenshots are captured in light mode.
dark_mode(false)

# Clean status bar (9:41, full battery/signal) on every device.
override_status_bar(true)

# The M1 CI/dev Macs run one simulator at a time more reliably.
concurrent_simulators(false)

stop_after_first_error(true)

# Simulator erase is handled by the `screenshots` lane (see Fastfile →
# prepare_screenshot_simulators), which erases the devices AND seeds
# SpringBoard prefs so iPadOS 26 boots in Full Screen Apps mode — the
# default Windowed Apps mode draws a window-resize grabber arc in the
# bottom-right corner of every capture. Keeping erase_simulator off here
# prevents snapshot from wiping those seeded prefs; the lane's erase keeps
# reruns idempotent (fresh UserDefaults / no stale pairing state).
erase_simulator(false)
